    isPartOf: {
      "@id": "https://roca-swimming.ro/#website",
    },
    about: {
      "@id": "https://roca-swimming.ro/#club",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Course",
    name: "Cursuri de înot pentru copii și adulți",
    description: "Inițiere și perfecționare la înot în Cluj-Napoca, în grupe mici sau sesiuni 1-la-1.",
    provider: {
      "@id": "https://roca-swimming.ro/#club",
    },
    offers: [
      {
        "@type": "Offer",
        name: "O ședință de înot",
        price: "100",
        priceCurrency: "RON",
        availability: "https://schema.org/InStock",
      },
      {
        "@type": "Offer",
        name: "Abonament 4 ședințe pe lună",
        price: "300",
        priceCurrency: "RON",
        availability: "https://schema.org/InStock",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Pot începe dacă nu știu deloc să înot?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Da. Cursurile sunt potrivite și pentru începători absoluți. Începem cu acomodarea în apă, plutirea, respirația și coordonarea, apoi introducem treptat mișcările de bază pentru stilurile de înot.",
        },
      },
      {
        "@type": "Question",
        name: "Ce se întâmplă dacă lipsesc?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Dacă știi că nu poți ajunge, anunță-ne cât mai devreme. Încercăm să găsim o variantă de reprogramare în limita locurilor disponibile și a programului grupelor.",
        },
      },
      {
        "@type": "Question",
        name: "Echipamentul chiar este obligatoriu?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Da. Pentru igienă, siguranță și confort ai nevoie de slip sau costum de înot, cască, ochelari, șlapi curați și prosop. Dacă ești la început și nu știi ce să alegi, îți putem recomanda echipament potrivit.",
        },
      },
      {
        "@type": "Question",
        name: "Cât costă cursurile de înot la RoCa Swimming Club?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "O ședință costă 100 lei, iar abonamentul de 4 ședințe pe lună costă 300 lei. Abonamentul este recomandat pentru progres constant, pentru că tehnica se fixează mai bine când antrenamentele sunt regulate.",
        },
      },
      {
        "@type": "Question",
        name: "Ce stiluri de înot se pot învăța la cursuri?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "În funcție de nivel, lucrăm progresiv la craul, spate, bras și elemente de bază pentru fluture. Pentru începători, prioritatea este siguranța în apă, respirația corectă și coordonarea, iar pentru cursanții mai avansați accentul cade pe tehnică, eficiență și rezistență.",
        },
      },
      {
        "@type": "Question",
        name: "Organizați cursuri de înot pentru adulți începători?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Da. RoCa Swimming Club lucrează cu adulți începători, inclusiv cu persoane care au emoții în apă. Construim progresul pas cu pas: acomodare, respirație, plutire, coordonare și apoi tehnică pentru stilurile de bază.",
        },
      },
      {
        "@type": "Question",
        name: "De la ce vârstă pot începe copiii cursurile de înot?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Pentru copii, recomandăm să ne contactezi înainte de înscriere ca să confirmăm vârsta, nivelul, grupa potrivită și disponibilitatea locurilor. Contează mult ca ritmul cursului să fie adaptat copilului, mai ales la primele lecții.",
        },
      },
    ],
  },
];
